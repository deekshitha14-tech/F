
import { Component } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { CommonModule } from '@angular/common';
@Component({
  selector: 'app-root',
  standalone: true,
  imports: [FormsModule, CommonModule],
  template: `
    <h2>Contact Form</h2>
    <form #f="ngForm" (ngSubmit)="submit(f.value)">
      <input name="name" ngModel #n="ngModel"
        placeholder="Name" required minlength="3">
      <small *ngIf="n.invalid && n.touched">Enter valid name</small><br><br>
      <input name="email" ngModel #e="ngModel"
        type="email" placeholder="Email" required email>
      <small *ngIf="e.invalid && e.touched">Enter valid email</small><br><br>
      <input name="phone" ngModel #p="ngModel"
        placeholder="Phone" required pattern="[0-9]{10}">
      <small *ngIf="p.invalid && p.touched">Enter valid phone number</small><br><br>
      <textarea name="message" ngModel #m="ngModel"
        placeholder="Message" required maxlength="100"></textarea>
      <small *ngIf="m.invalid && m.touched">Enter valid message</small><br><br>
      <button [disabled]="f.invalid">Submit</button>
    </form>
  `,
  styles: [`
    input, textarea {
      padding: 10px;
      border: 1px solid black;
      border-radius: 5px;
      width: 250px;
    }
    small {
      color: red;
    }
  `]
})
export class App {
  submit(data: any) {
    console.log(data);
    alert('Submitted Successfully!');
  }
}
