<!DOCTYPE html>
<html>
<head>
    <title>My Personal Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }
        .hero {
            background: #343a40;
            color: white;
            padding: 50px 20px;
            text-align: center;
        }
        .card:hover {
            transform: translateY(-5px);
        }
    </style>
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="#">My Blog</a>
    </div>
</nav>

<section class="hero">
    <img src="me.jpg" class="img-fluid rounded" width="200">
    <h1>Welcome to My Personal Blog</h1>
    <p>I share my thoughts, experiences and ideas.</p>
    <a href="#blog" class="btn btn-primary">Explore My Blog</a>
</section>

<section class="container py-5" id="blog">
    <h2 class="text-center mb-4">My Blog</h2>
    <div class="row justify-content-center">

        <div class="col-md-4 mb-3">
            <div class="card text-center p-3">
                <div class="card-body">
                    <h3>About Me</h3>
                    <p>Learn about my interests, hobbies and goals.</p>
                    <a href="#about" class="btn btn-info">Read More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center p-3">
                <div class="card-body">
                    <h3>Contact Me</h3>
                    <p>Feel free to connect and share your thoughts.</p>
                    <a href="#contact" class="btn btn-info">Contact</a>
                </div>
            </div>
        </div>

    </div>
</section>

<footer class="bg-dark text-white text-center p-3">
    © 2026 My Personal Blog
</footer>

</body>
</html>
