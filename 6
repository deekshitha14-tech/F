import {useState,useEffect} from 'react'; 
import"./App.css";
export default function App(){
  const[task,setTask]=useState("");
  const[list,setList]=useState([]);
  useEffect(()=>{localStorage.setItem("tasks",JSON.stringify(list));},[list]);
  const add=()=>{
    if(!task.trim()) return;
    setList([...list,{task,done:false}]);
    setTask("");
  };
  const toggle =i =>setList(list.map((t,x)=>x==i?{...t,done:!t.done}:t));
  const del=i=>setList(list.filter((_,x)=>x!==i));
 const done=list.filter(t=>t.done).length;
 return(
  <div className="card">
    <h1>To-Do List</h1>
    <div className="stats">
      <p>Tasks: {list.length}</p>
      <p>Completed: {done}</p>
      <p>Pending: {list.length-done}</p>
    </div>
  
  <div className="row">
  <input placeholder="Enter task" value={task} onChange={e=>setTask(e.target.value)}/>
  <button onClick={add}>Add</button>
  </div>
  <ul>
    {list.map((t,i)=>(
      <li key={i} className={t.done?"done":""}>
        <b>{t.task}</b>
        <div>
          <button onClick={()=>toggle(i)}>{t.done?"Undo":"Done"}</button>
          <button onClick={()=>del(i)}>Delete</button>
        </div>  
    </li>
    ))}
  </ul>
  </div>
  );
}
